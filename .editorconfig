root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{html,css,js,mjs,ts,json,yaml,yml,toml}]
indent_size = 2

[*.lua]
indent_size = 2

[Makefile]
indent_style = tab
