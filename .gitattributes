# Force LF line endings for all text files in the repo (matches Python/Lua/web tooling).
# Working trees on Windows still see CRLF if core.autocrlf=true; the canonical form is LF.

*               text=auto eol=lf

# Source code
*.py            text eol=lf
*.lua           text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.ts            text eol=lf
*.json          text eol=lf
*.toml          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
*.rst           text eol=lf
*.cfg           text eol=lf
*.ini           text eol=lf

# Shell / scripts
*.sh            text eol=lf
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.dll           binary
*.exe           binary
*.so            binary
*.dylib         binary
*.zip           binary
*.7z            binary
*.tar           binary
*.tgz           binary
*.gz            binary

# Don't try to diff these
LICENSE         -diff
*.lock          -diff
